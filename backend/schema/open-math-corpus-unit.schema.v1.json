        "sections": {"type": "integer", "minimum": 0},
        "exercises": {"type": "integer", "minimum": 0},
        "hints": {"type": "integer", "minimum": 0},
        "answers": {"type": "integer", "minimum": 0},
        "solutions": {"type": "integer", "minimum": 0},
        "citations": {"type": "integer", "minimum": 0},
        "diagrams": {"type": "integer", "minimum": 0},
        "index_entries": {"type": "integer", "minimum": 0}
      }
