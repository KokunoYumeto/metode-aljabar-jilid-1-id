{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uuid:9b305c34-aa72-50d7-bee7-64c47080e452",
  "title": "Open Mathematics Corpus Unit Backend v1",
  "description": "Language-neutral, hash-bound record for one independently buildable corpus unit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_name",
    "schema_version",
    "profile",
    "dataset_id",
    "dataset_stable_key",
    "id_namespace",
    "workflow",
    "program",
    "course",
    "resource",
    "edition",
    "unit",
    "sections",
    "concepts",
    "prerequisites",
    "rights",
    "citations",
    "diagrams",
    "index_entries",
    "build_surfaces",
    "qa_events"
  ],
  "properties": {
    "$schema": {"const": "../schema/open-math-corpus-unit.schema.v1.json"},
    "schema_name": {"const": "open-math-corpus-unit"},
    "schema_version": {"const": "1.1.0"},
    "profile": {"const": "curriculum-modular-backend-v0"},
    "dataset_id": {"$ref": "#/$defs/uuidUrn"},
    "dataset_stable_key": {"$ref": "#/$defs/stableKey"},
    "id_namespace": {"$ref": "#/$defs/idNamespace"},
    "workflow": {"$ref": "#/$defs/workflow"},
    "program": {"$ref": "#/$defs/program"},
    "course": {"$ref": "#/$defs/course"},
    "resource": {"$ref": "#/$defs/resource"},
    "edition": {"$ref": "#/$defs/edition"},
    "unit": {"$ref": "#/$defs/unit"},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/section"}
    },
    "concepts": {
      "type": "array",
      "items": {"$ref": "#/$defs/concept"}
    },
    "prerequisites": {
      "type": "array",
      "items": {"$ref": "#/$defs/prerequisite"}
    },
    "rights": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rights"}
    },
    "citations": {
      "type": "array",
      "items": {"$ref": "#/$defs/citation"}
    },
    "diagrams": {
      "type": "array",
      "items": {"$ref": "#/$defs/diagram"}
    },
    "index_entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/indexEntry"}
    },
    "build_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/buildSurface"}
    },
    "qa_events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/qaEvent"}
    }
  },
  "$defs": {
    "uuidUrn": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "stableKey": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "entityCore": {
      "type": "object",
      "required": ["id", "stable_key", "entity_type"],
      "properties": {
        "id": {"$ref": "#/$defs/uuidUrn"},
        "stable_key": {"$ref": "#/$defs/stableKey"},
        "entity_type": {"type": "string"}
      }
    },
    "localizedLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "text"],
      "properties": {
        "language": {"$ref": "#/$defs/locale"},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "lineBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256",
        "line_start",
        "line_end",
        "span_sha256",
        "span_hash_algorithm"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "span_sha256": {"$ref": "#/$defs/sha256"},
        "span_hash_algorithm": {"const": "sha256-utf8-lines-lf-v1"}
      }
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "idNamespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "namespace_uuid", "name_root"],
      "properties": {
        "algorithm": {"const": "uuid5"},
        "namespace_uuid": {"$ref": "#/$defs/uuidUrn"},
        "name_root": {"type": "string", "minLength": 1}
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responsible_task",
        "updated",
        "status",
        "admission_state",
        "translation_state",
        "qa_state"
      ],
      "properties": {
        "responsible_task": {"type": "string", "minLength": 1},
        "updated": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "status": {"enum": ["candidate", "admitted", "superseded", "blocked"]},
        "admission_state": {"enum": ["not_admitted", "admitted"]},
        "translation_state": {
          "enum": [
            "source_frozen",
            "queued",
            "draft",
            "translated",
            "structurally_verified",
            "mathematically_reviewed",
            "language_reviewed",
            "built",
            "visually_checked",
            "published",
            "superseded",
            "blocked"
          ]
        },
        "qa_state": {"type": "string", "minLength": 1}
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stable_key", "entity_type", "label", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/uuidUrn"},
        "stable_key": {"$ref": "#/$defs/stableKey"},
        "entity_type": {"const": "program"},
        "label": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stable_key",
        "entity_type",
        "program_id",
        "role_code",
        "course_code",
        "label",
        "prerequisite_ids"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/uuidUrn"},
        "stable_key": {"$ref": "#/$defs/stableKey"},
        "entity_type": {"const": "course"},
        "program_id": {"$ref": "#/$defs/uuidUrn"},
        "role_code": {"const": "O013"},
        "course_code": {"const": "D70"},
        "label": {"type": "string", "minLength": 1},
        "prerequisite_ids": {"type": "array", "items": {"$ref": "#/$defs/uuidUrn"}}
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stable_key",
        "entity_type",
        "canonical_uri",
        "author",
        "titles",
        "original_language",
        "rights_component_ids"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/uuidUrn"},
        "stable_key": {"$ref": "#/$defs/stableKey"},
        "entity_type": {"const": "resource"},
        "canonical_uri": {"type": "string", "minLength": 1},
        "author": {"type": "string", "minLength": 1},
        "titles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/localizedLabel"}},
        "original_language": {"$ref": "#/$defs/locale"},
        "rights_component_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/uuidUrn"}}
      }
    },
    "edition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stable_key",
        "entity_type",
        "resource_id",
        "branch",
        "commit",
        "tree",
        "archive",
        "official_pdf",
        "source_manifest"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/uuidUrn"},
        "stable_key": {"$ref": "#/$defs/stableKey"},
        "entity_type": {"const": "edition"},
        "resource_id": {"$ref": "#/$defs/uuidUrn"},
        "branch": {"type": "string", "minLength": 1},
        "commit": {"$ref": "#/$defs/sha1"},
        "tree": {"$ref": "#/$defs/sha1"},
        "archive": {"$ref": "#/$defs/fileBinding"},
        "official_pdf": {"$ref": "#/$defs/fileBinding"},
        "source_manifest": {"$ref": "#/$defs/fileBinding"}
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stable_key",
        "entity_type",
        "program_id",
        "course_id",
        "resource_id",
        "edition_id",
        "order",
        "source_local_id",
        "titles",
        "source_language",
        "target_language",
        "source_binding",
        "target_binding",
        "section_ids",
        "concept_ids",
        "prerequisite_ids",
        "rights_component_ids",
        "citation_ids",
        "diagram_ids",
        "index_entry_ids",
        "build_surface_ids",
        "qa_event_ids",
        "outcome_keys",
        "surface_counts",
        "translation_state",
        "admission_state"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/uuidUrn"},
        "stable_key": {"$ref": "#/$defs/stableKey"},
        "entity_type": {"const": "unit"},
        "program_id": {"$ref": "#/$defs/uuidUrn"},
        "course_id": {"$ref": "#/$defs/uuidUrn"},
        "resource_id": {"$ref": "#/$defs/uuidUrn"},
        "edition_id": {"$ref": "#/$defs/uuidUrn"},
        "order": {"type": "integer", "minimum": 1},
        "source_local_id": {"type": "string", "minLength": 1},
        "titles": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/localizedLabel"}},
        "source_language": {"$ref": "#/$defs/locale"},
        "target_language": {"$ref": "#/$defs/locale"},
        "source_binding": {"$ref": "#/$defs/lineBinding"},
        "target_binding": {"$ref": "#/$defs/lineBinding"},
        "section_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/uuidUrn"}},
        "concept_ids": {"type": "array", "items": {"$ref": "#/$defs/uuidUrn"}},
        "prerequisite_ids": {"type": "array", "items": {"$ref": "#/$defs/uuidUrn"}},
        "rights_component_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/uuidUrn"}},
        "citation_ids": {"type": "array", "items": {"$ref": "#/$defs/uuidUrn"}},
        "diagram_ids": {"type": "array", "items": {"$ref": "#/$defs/uuidUrn"}},
        "index_entry_ids": {"type": "array", "items": {"$ref": "#/$defs/uuidUrn"}},
        "build_surface_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/uuidUrn"}},
        "qa_event_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/uuidUrn"}},
        "outcome_keys": {"type": "array", "items": {"$ref": "#/$defs/stableKey"}},
        "surface_counts": {"$ref": "#/$defs/surfaceCounts"},
        "translation_state": {
          "enum": ["draft", "translated", "structurally_verified", "mathematically_reviewed", "language_reviewed", "built", "visually_checked", "published"]
        },
        "admission_state": {"enum": ["not_admitted", "admitted"]}
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stable_key",
        "entity_type",
        "parent_id",
        "order",
        "source_local_id",
        "titles",
        "source_binding",
        "target_binding",
        "concept_ids",
        "prerequisite_ids",
        "rights_component_ids",
        "translation_state",
        "admission_state"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/uuidUrn"},
        "stable_key": {"$ref": "#/$defs/stableKey"},
        "entity_type": {"const": "section"},
        "parent_id": {"$ref": "#/$defs/uuidUrn"},
        "order": {"type": "integer", "minimum": 1},
        "source_local_id": {"type": "string", "minLength": 1},
        "titles": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/localizedLabel"}},
        "source_binding": {"$ref": "#/$defs/lineBinding"},
        "target_binding": {"$ref": "#/$defs/lineBinding"},
        "concept_ids": {"type": "array", "items": {"$ref": "#/$defs/uuidUrn"}},
        "prerequisite_ids": {"type": "array", "items": {"$ref": "#/$defs/uuidUrn"}},
        "rights_component_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/uuidUrn"}},
        "translation_state": {
          "enum": ["draft", "translated", "structurally_verified", "mathematically_reviewed", "language_reviewed", "built", "visually_checked", "published"]
        },
        "admission_state": {"enum": ["not_admitted", "admitted"]}
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stable_key", "entity_type", "labels"],
      "properties": {
        "id": {"$ref": "#/$defs/uuidUrn"},
        "stable_key": {"$ref": "#/$defs/stableKey"},
        "entity_type": {"const": "concept"},
        "labels": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/localizedLabel"}}
      }
    },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stable_key",
        "entity_type",
        "labels",
        "requiredness",
        "source_evidence"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/uuidUrn"},
        "stable_key": {"$ref": "#/$defs/stableKey"},
        "entity_type": {"const": "prerequisite"},
        "labels": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/localizedLabel"}},
        "requiredness": {"enum": ["expected", "recommended"]},
        "source_evidence": {"$ref": "#/$defs/evidenceLocator"}
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stable_key",
        "entity_type",
        "component",
        "holder_or_source",
        "license",
        "required_treatment",
        "applies_to_unit",
        "bindings"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/uuidUrn"},
        "stable_key": {"$ref": "#/$defs/stableKey"},
        "entity_type": {"const": "rights"},
        "component": {"type": "string", "minLength": 1},
        "holder_or_source": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "required_treatment": {"type": "string", "minLength": 1},
        "applies_to_unit": {"type": "boolean"},
        "bindings": {"type": "array", "items": {"$ref": "#/$defs/fileBinding"}}
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stable_key",
        "entity_type",
        "bib_key",
        "bibliography_path",
        "bibliography_sha256",
        "source_line",
        "target_line",
        "section_id"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/uuidUrn"},
        "stable_key": {"$ref": "#/$defs/stableKey"},
        "entity_type": {"const": "citation"},
        "bib_key": {"type": "string", "minLength": 1},
        "bibliography_path": {"type": "string", "minLength": 1},
        "bibliography_sha256": {"$ref": "#/$defs/sha256"},
        "source_line": {"type": "integer", "minimum": 1},
        "target_line": {"type": "integer", "minimum": 1},
        "section_id": {"$ref": "#/$defs/uuidUrn"}
      }
    },
    "diagram": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stable_key",
        "entity_type",
        "section_id",
        "ordinal_in_unit",
        "source_format",
        "source_occurrence_index",
        "source_binding",
        "target_binding",
        "rights_component_id",
        "state"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/uuidUrn"},
        "stable_key": {"$ref": "#/$defs/stableKey"},
        "entity_type": {"const": "diagram"},
        "section_id": {"$ref": "#/$defs/uuidUrn"},
        "ordinal_in_unit": {"type": "integer", "minimum": 1},
        "source_format": {"enum": ["tikzcd", "tikzpicture"]},
        "source_occurrence_index": {"type": "integer", "minimum": 1},
        "source_binding": {"$ref": "#/$defs/lineBinding"},
        "target_binding": {"$ref": "#/$defs/lineBinding"},
        "rights_component_id": {"$ref": "#/$defs/uuidUrn"},
        "state": {"enum": ["candidate_pending_audit", "audited_preserved"]}
      }
    },
    "indexEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stable_key",
        "entity_type",
        "section_id",
        "ordinal_in_unit",
        "source_key",
        "target_key",
        "source_binding",
        "target_binding",
        "provenance_state"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/uuidUrn"},
        "stable_key": {"$ref": "#/$defs/stableKey"},
        "entity_type": {"const": "index_entry"},
        "section_id": {"$ref": "#/$defs/uuidUrn"},
        "ordinal_in_unit": {"type": "integer", "minimum": 1},
        "source_key": {"type": "string", "minLength": 1},
        "target_key": {"type": "string", "minLength": 1},
        "source_binding": {"$ref": "#/$defs/lineBinding"},
        "target_binding": {"$ref": "#/$defs/lineBinding"},
        "provenance_state": {"const": "source_key_preserved_target_key_localized"}
      }
    },
    "buildSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stable_key",
        "entity_type",
        "unit_id",
        "kind",
        "working_directory",
        "command",
        "artifact_path",
        "artifact_binding",
        "log_binding",
        "build_script",
        "page_count",
        "status",
        "driver",
        "input_bindings",
        "external_dependencies",
        "rights_component_ids"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/uuidUrn"},
        "stable_key": {"$ref": "#/$defs/stableKey"},
        "entity_type": {"const": "build_surface"},
        "unit_id": {"$ref": "#/$defs/uuidUrn"},
        "kind": {"const": "pdf"},
        "working_directory": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "artifact_path": {"type": "string", "minLength": 1},
        "status": {"enum": ["pending_current_candidate_build", "pass"]},
        "driver": {"$ref": "#/$defs/fileBinding"},
        "artifact_binding": {"$ref": "#/$defs/fileBinding"},
        "log_binding": {"$ref": "#/$defs/fileBinding"},
        "build_script": {"$ref": "#/$defs/fileBinding"},
        "page_count": {"type": "integer", "minimum": 1},
        "input_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileBinding"}},
        "external_dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "rights_component_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/uuidUrn"}}
      }
    },
    "qaEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stable_key",
        "entity_type",
        "unit_id",
        "check_type",
        "result",
        "scope",
        "witness",
        "translation_audit_state",
        "build_state",
        "visual_state",
        "witness_binding"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/uuidUrn"},
        "stable_key": {"$ref": "#/$defs/stableKey"},
        "entity_type": {"const": "qa_event"},
        "unit_id": {"$ref": "#/$defs/uuidUrn"},
        "check_type": {"enum": ["backend_integrity", "admission_gate"]},
        "result": {"const": "pass"},
        "scope": {"type": "string", "minLength": 1},
        "witness": {"type": "string", "minLength": 1},
        "translation_audit_state": {"enum": ["pending", "pass"]},
        "build_state": {"enum": ["pending", "pass"]},
        "visual_state": {"enum": ["pending", "pass"]},
        "witness_binding": {"$ref": "#/$defs/fileBinding"}
      }
    },
    "surfaceCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sections", "exercises", "hints", "answers", "solutions", "citations", "diagrams", "index_entries"],
