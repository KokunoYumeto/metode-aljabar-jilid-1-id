# Immutable authority witnesses and local build products
/authority/
/build/

# Full-page render evidence is retained locally; compact receipts are tracked.
/qa/unit-001-final-*/
/qa/unit-002-final-*/
/qa/unit-003-final-*/
/qa/unit-004-final-*/

# Task-local recovery and user-instruction records are not publication metadata.
/00_control/CURRENT_*
/00_control/RECOVERY_POINTER.json
/00_control/WORKLOG.jsonl
/00_control/ADVERSE_LEDGER.jsonl
/00_control/DECISION_LOG.md
/00_control/USER_INSTRUCTIONS_*.md
/00_control/O013_COMPOSITE_SELECTION_*.md

# Interpreter and TeX transient files
__pycache__/
*.pyc
*.aux
*.bbl
*.bcf
*.blg
*.idx
*.ilg
*.ind
*.log
*.out
*.run.xml
*.toc
*.xdv

